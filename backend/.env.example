# Copy to backend/.env or repo root .env and fill in real values.
# DO NOT commit real API keys.

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DB=interview_guide
MYSQL_USER=root
MYSQL_PASSWORD=123456

# Redis（与 docker-compose 一致：密码 redis）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# MinIO / S3
APP_STORAGE_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
APP_STORAGE_BUCKET=interview-guide

# AI（OpenAI 兼容；Spring AI 会拼 /v1/chat/completions，base 勿再带 /v1）
# DashScope 示例：https://dashscope.aliyuncs.com/compatible-mode
# 百炼/MaaS 若文档给的是 .../api/v1，这里应写成 .../api
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_API_KEY=sk-your-dashscope-key
AI_MODEL=qwen-plus

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Token TTL（小时）
AUTH_TOKEN_TTL_HOURS=24

# ---- 默认测试账号（种子 / 管理端创建）----
# 管理员：启动时若不存在则自动创建；demo-seed.sql 也会写入
#   username=admin  password=admin123
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_REAL_NAME=系统管理员
#
# 候选人演示账号（见 docs/sql/demo-seed.sql）：
#   13800000001 / 13800000002 / 13800000003
#   password=candidate123
