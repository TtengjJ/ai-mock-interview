# 仓库根环境变量示例（docker compose --profile full 时可放此处）
# 也可只使用 backend/.env.example → backend/.env

MYSQL_PASSWORD=123456
# 本机 mysqld 已占 3306 时，Docker MySQL 映射为 3307
MYSQL_PORT=3307
REDIS_PASSWORD=redis
# Spring AI 会再拼 /v1/chat/completions，base 不要带末尾 /v1
AI_API_KEY=sk-your-dashscope-key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_MODEL=qwen-plus
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_REAL_NAME=系统管理员
